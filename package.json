{
  "name": "@company/design-system",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck && pnpm typecheck:registry",
    "typecheck:registry": "tsc -p registry/tsconfig.json --noEmit",
    "test": "turbo test",
    "company-ui": "pnpm --filter company-ui start",
    "storybook": "pnpm --filter @company/storybook storybook",
    "build:storybook": "pnpm --filter @company/storybook build-storybook",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "turbo build && changeset publish"
  },
  "devDependencies": {
    "@base-ui/react": "^1.8.0",
    "@changesets/cli": "^2.29.7",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.5.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitest/browser": "3.2.7",
    "jsdom": "^27.0.0",
    "playwright": "1.63.0",
    "tsup": "^8.5.0",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
