{
  "name": "@company/design-system",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo typecheck && pnpm typecheck:registry",
    "typecheck:registry": "tsc -p registry/tsconfig.json --noEmit",
    "test": "turbo test && pnpm exec vitest run -c registry/vitest.config.ts",
    "typecheck:personal": "tsc -p registry/personal/tsconfig.json --noEmit",
    "registry:register": "node scripts/registry-version.mjs register",
    "registry:check": "node scripts/registry-version.mjs check",
    "registry:bump": "node scripts/registry-version.mjs bump",
    "registry:log": "node scripts/registry-version.mjs log",
    "personal:sync": "node scripts/personal.mjs sync",
    "personal:diff": "node scripts/personal.mjs diff",
    "personal:list": "pnpm company-ui list --registry \"$PWD/registry.personal.json\"",
    "company-ui": "pnpm --filter company-ui start",
    "storybook": "pnpm --filter @company/storybook storybook",
    "build:storybook": "pnpm --filter @company/storybook build-storybook",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "turbo build && changeset publish"
  },
  "devDependencies": {
    "@base-ui/react": "^1.8.0",
    "@changesets/cli": "^2.29.7",
    "@eslint/js": "^9.39.5",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.5.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitest/browser": "3.2.7",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^27.0.0",
    "playwright": "1.63.0",
    "prettier": "^3.9.8",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "storybook": "^10.6.0",
    "tsup": "^8.5.0",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^3.2.4"
  }
}
